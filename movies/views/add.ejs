<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MovieHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f4f5;
            color: #18181b;
        }

        /* Navbar */
        nav {
            height: 70px;
            background: #18181b;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 8%;
        }

        .logo {
            color: #ffffff;
            font-size: 25px;
            font-weight: bold;
        }

        .logo span {
            color: #e11d48;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: #ffffff;
            text-decoration: none;
            font-size: 15px;
            transition: 0.2s;
        }

        .nav-links a:hover {
            color: #e11d48;
        }

        /* Hero */
        .hero {
            padding: 70px 8% 50px;
            background: #ffffff;
        }

        .hero h1 {
            font-size: 45px;
            margin-bottom: 12px;
        }

        .hero h1 span {
            color: #e11d48;
        }

        .hero p {
            color: #71717a;
            font-size: 17px;
        }

        /* Movies section */
        .movies-section {
            padding: 50px 8%;
        }

        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .section-title h2 {
            font-size: 28px;
        }

        /* Movie Grid */
        .movie-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        /* Movie Card */
        .movie-card {
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e4e4e7;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .movie-poster {
            width: 100%;
            height: 330px;
            object-fit: cover;
        }

        .movie-info {
            padding: 20px;
        }

        .movie-info h3 {
            font-size: 21px;
            margin-bottom: 8px;
        }

        .movie-meta {
            color: #71717a;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .details-btn {
            display: block;
            width: 100%;
            text-align: center;
            background: #18181b;
            color: #ffffff;
            text-decoration: none;
            padding: 11px;
            border-radius: 7px;
            font-size: 14px;
            transition: 0.2s;
        }

        .details-btn:hover {
            background: #e11d48;
        }

        /* Footer */
        footer {
            margin-top: 40px;
            padding: 25px;
            text-align: center;
            background: #18181b;
            color: #a1a1aa;
            font-size: 14px;
        }

        /* Responsive */
        @media (max-width: 900px) {
            .movie-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            nav {
                padding: 0 5%;
            }

            .nav-links {
                gap: 15px;
            }

            .hero,
            .movies-section {
                padding-left: 5%;
                padding-right: 5%;
            }

            .hero h1 {
                font-size: 35px;
            }

            .movie-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
