
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MovieHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f4f5;
            color: #18181b;
        }

        /* ================= NAVBAR ================= */

        nav {
            height: 70px;
            background: #18181b;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 8%;
        }

        .logo {
            color: white;
            font-size: 25px;
            font-weight: bold;
        }

        .logo span {
            color: #e11d48;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 15px;
        }

        .nav-links a:hover {
            color: #e11d48;
        }

        /* ================= HERO ================= */

        .hero {
            text-align: center;
            padding: 60px 20px 40px;
            background: white;
        }

        .hero h1 {
            font-size: 45px;
            margin-bottom: 10px;
        }

        .hero h1 span {
            color: #e11d48;
        }

        .hero p {
            color: #71717a;
            font-size: 17px;
        }

        /* ================= MOVIES ================= */

        .movies-section {
            padding: 50px 8%;
        }

        .movies-section h2 {
            font-size: 30px;
            margin-bottom: 30px;
        }

        .movie-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        /* ================= MOVIE CARD ================= */

        .movie-card {
            background: white;
            border: 1px solid #e4e4e7;
            border-radius: 10px;
            overflow: hidden;

            transition: 0.2s;
        }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .movie-poster {
            width: 100%;
            height: 350px;
            object-fit: cover;
        }

        .movie-info {
            padding: 20px;
        }

        .movie-info h3 {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .movie-info p {
            color: #71717a;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .movie-description {
            margin-top: 12px;
            line-height: 1.5;
        }

        /* ================= VIEW ALL BUTTON ================= */

        .view-all {
            text-align: center;
            margin-top: 40px;
        }

        .view-all-btn {
            display: inline-block;

            padding: 13px 30px;

            background: #18181b;
            color: white;

            text-decoration: none;
            border-radius: 7px;

            font-size: 16px;
            font-weight: 600;

            transition: 0.2s;
        }

        .view-all-btn:hover {
            background: #e11d48;
        }

        /* ================= FOOTER ================= */

        footer {
            margin-top: 30px;
            padding: 25px;

            text-align: center;

            background: #18181b;
            color: #a1a1aa;

            font-size: 14px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 900px) {
            .movie-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {

            nav {
                padding: 0 5%;
            }

            .nav-links {
                gap: 15px;
            }

            .hero h1 {
                font-size: 35px;
            }

            .movies-section {
                padding: 40px 5%;
            }

            .movie-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav>

        <div class="logo">
            Movie<span>Hub</span>
        </div>

        <ul class="nav-links">

            <li>
                <a href="/">Home</a>
            </li>

            <li>
                <a href="/movies">Movies</a>
            </li>

            <li>
                <a href="/movies/add">Add Movies</a>
            </li>

        </ul>

    </nav>


    <!-- ================= HERO ================= -->

    <section class="hero">

        <h1>
            Welcome to <span>MovieHub</span>
        </h1>

        <p>
            Discover and explore your favorite movies.
        </p>

    </section>


    <!-- ================= MOVIES ================= -->

    <section class="movies-section">

        <h2>Featured Movies</h2>

        <div class="movie-grid">

            <!-- MOVIE 1 -->

            <div class="movie-card">

                <img
                    class="movie-poster"
                    src="https://via.placeholder.com/500x750?text=Inception"
                    alt="Inception"
                >

                <div class="movie-info">

                    <h3>Inception</h3>

                    <p>
                        <strong>Genre:</strong> Sci-Fi, Thriller
                    </p>

                    <p>
                        <strong>Year:</strong> 2010
                    </p>

                    <p>
                        <strong>Rating:</strong> ⭐ 8.8/10
                    </p>

                    <p class="movie-description">
                        A skilled thief enters people's dreams to steal
                        valuable secrets.
                    </p>

                </div>

            </div>


            <!-- MOVIE 2 -->

            <div class="movie-card">

                <img
                    class="movie-poster"
                    src="https://via.placeholder.com/500x750?text=Interstellar"
                    alt="Interstellar"
                >

                <div class="movie-info">

                    <h3>Interstellar</h3>

                    <p>
                        <strong>Genre:</strong> Sci-Fi, Drama
                    </p>

                    <p>
                        <strong>Year:</strong> 2014
                    </p>

                    <p>
                        <strong>Rating:</strong> ⭐ 8.7/10
                    </p>

                    <p class="movie-description">
                        Explorers travel through space searching for a
                        new home for humanity.
                    </p>

                </div>

            </div>


            <!-- MOVIE 3 -->

            <div class="movie-card">

                <img
                    class="movie-poster"
                    src="https://via.placeholder.com/500x750?text=The+Dark+Knight"
                    alt="The Dark Knight"
                >

                <div class="movie-info">

                    <h3>The Dark Knight</h3>

                    <p>
                        <strong>Genre:</strong> Action, Crime
                    </p>

                    <p>
                        <strong>Year:</strong> 2008
                    </p>

                    <p>
                        <strong>Rating:</strong> ⭐ 9.0/10
                    </p>

                    <p class="movie-description">
                        Batman faces a dangerous criminal who creates
                        chaos across Gotham City.
                    </p>

                </div>

            </div>

        </div>


        <!-- ONLY ONE BUTTON AFTER THE 3 MOVIES -->

        <div class="view-all">

            <a href="/movies" class="view-all-btn">
                View All Movies
            </a>

        </div>

    </section>


    <!-- ================= FOOTER ================= -->

    <footer>
        © 2026 MovieHub. All rights reserved.
    </footer>

</body>
</html>

