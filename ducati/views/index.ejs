
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Ducati | Home</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <header class="navbar">

    <a href="/" class="logo">
      DUCATI
    </a>

    <nav>
      <a href="/" class="active">Home</a>
      <a href="/discover">Discover</a>
      <a href="/test-drive">Test Ride</a>
      <a href="/customize">Customize</a>
    </nav>

    <a href="/test-drive" class="nav-btn">
      Test Ride
    </a>

  </header>


  <main>

    <section
      class="hero"
      style="
        background-image:
        linear-gradient(
          90deg,
          rgba(0,0,0,.96) 0%,
          rgba(0,0,0,.78) 35%,
          rgba(0,0,0,.30) 70%,
          rgba(0,0,0,.08) 100%
        ),
        url('https://cdn-s3.autocarindia.com/Ducati/panigale-v4/Panigale%20V4_1.jpg');
      "
    >

      <div class="hero-content">

        <div class="hero-label">
          <span></span>
          DUCATI PERFORMANCE
        </div>

        <h1>
          PANIGALE
          <strong>V4</strong>
        </h1>

        <p class="hero-description">
          The ultimate expression of Ducati racing DNA.
          Italian design, extraordinary performance and
          pure riding emotion.
        </p>

        <div class="hero-specs">

          <div>
            <strong>1103</strong>
            <span>CC</span>
          </div>

          <div>
            <strong>216</strong>
            <span>HP</span>
          </div>

          <div>
            <strong>V4</strong>
            <span>ENGINE</span>
          </div>

        </div>

        <div class="hero-buttons">

          <a href="/discover" class="btn">
            Discover
          </a>

          <a href="/test-drive" class="btn outline">
            Test Ride
          </a>

        </div>

      </div>

      <div class="hero-side-text">
        <span>RACING DNA</span>
        <span>ITALIAN ENGINEERING</span>
      </div>

    </section>


    <section class="bikes-section">

      <div class="section-top">

        <div>

          <p class="section-label">
            DUCATI MOTORCYCLES
          </p>

          <h2>
            FIND YOUR<br>
            <span>DUCATI</span>
          </h2>

        </div>

        <p class="section-intro">
          Discover the Ducati range.
          From superbikes built for the track to
          motorcycles made for everyday adventure.
        </p>

      </div>


      <div class="bike-grid">

        <% bikes.forEach((bike, index) => { %>

          <article class="bike-card">

            <div class="bike-image">

              <img
                src="<%= bike.image %>"
                alt="<%= bike.name %>"
                loading="lazy"
              >

              <span class="bike-index">
                <%= String(index + 1).padStart(2, "0") %>
              </span>

              <div class="image-overlay"></div>

            </div>


            <div class="bike-info">

              <p class="bike-category">
                DUCATI MOTORCYCLE
              </p>

              <h3>
                <%= bike.name %>
              </h3>

              <p class="bike-details">
                <%= bike.details %>
              </p>


              <div class="bike-footer">

                <div class="price">

                  <span>STARTING FROM</span>

                  <strong>
                    <%= bike.price %>
                  </strong>

                </div>

                <a href="/discover" class="arrow-btn">
                  →
                </a>

              </div>

            </div>

          </article>

        <% }) %>

      </div>

    </section>


    <section
      class="cta-section"
      style="
        background-image:
        linear-gradient(
          90deg,
          rgba(0,0,0,.95),
          rgba(0,0,0,.60),
          rgba(0,0,0,.25)
        ),
        url('https://cdn-s3.autocarindia.com/Ducati/Streetfighter-V4/Streetfighter%20V4_8.jpg');
      "
    >

      <div class="cta-content">

        <p class="section-label">
          EXPERIENCE DUCATI
        </p>

        <h2>
          FEEL THE<br>
          <span>RUSH</span>
        </h2>

        <p>
          Your next ride is waiting.
          Book a Ducati test ride and experience
          Italian performance for yourself.
        </p>

        <a href="/test-drive" class="btn">
          Book Test Ride
        </a>

      </div>

    </section>

  </main>


  <footer>

    <div class="footer-inner">

      <div class="footer-brand">
        DUCATI
      </div>

      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/discover">Discover</a>
        <a href="/test-drive">Test Ride</a>
        <a href="/customize">Customize</a>
      </div>

      <p>
        © 2026 Ducati. All rights reserved.
      </p>

    </div>

  </footer>

</body>
</html>

