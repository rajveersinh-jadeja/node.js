<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= movie.title %> - MovieBox</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
            padding: 40px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 25px;
            color: #222;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .movie-details {
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 30px;
            display: flex;
            gap: 35px;
        }

        .movie-poster {
            width: 300px;
            height: 420px;
            object-fit: cover;
            border-radius: 8px;
            flex-shrink: 0;
        }

        .movie-info {
            flex: 1;
        }

        .movie-info h1 {
            font-size: 32px;
            margin-bottom: 20px;
        }

        .movie-info p {
            margin-bottom: 12px;
            line-height: 1.5;
            color: #555;
        }

        .movie-info strong {
            color: #222;
        }

        .description {
            margin-bottom: 20px !important;
        }

        .actions {
            display: flex;
            gap: 10px;
            margin-top: 25px;
        }

        .btn {
            display: inline-block;
            padding: 10px 16px;
            background: #222;
            color: white;
            text-decoration: none;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn:hover {
            background: #444;
        }

        .delete-btn {
            background: #b00020;
        }

        .delete-btn:hover {
            background: #8b0019;
        }

        @media (max-width: 700px) {
            body {
                padding: 20px;
            }

            .movie-details {
                flex-direction: column;
                padding: 20px;
            }

            .movie-poster {
                width: 100%;
                height: 400px;
            }

            .movie-info h1 {
                font-size: 26px;
            }

            .actions {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <a href="/" class="back-link">
            ← Back to Movies
        </a>

        <div class="movie-details">

            <% if (movie.poster) { %>

                <img
                    class="movie-poster"
                    src="<%= movie.poster %>"
                    alt="<%= movie.title %>"
                    onerror="this.onerror=null; this.src='https://via.placeholder.com/300x420?text=No+Poster';"
                >

            <% } else { %>

                <img
                    class="movie-poster"
                    src="https://via.placeholder.com/300x420?text=No+Poster"
                    alt="No Poster"
                >

            <% } %>


            <div class="movie-info">

                <h1><%= movie.title %></h1>

                <p class="description">
                    <strong>Description:</strong>
                    <%= movie.description %>
                </p>

                <p>
                    <strong>Genre:</strong>
                    <%= movie.genre %>
                </p>

                <p>
                    <strong>Release Year:</strong>
                    <%= movie.releaseYear %>
                </p>

                <p>
                    <strong>Duration:</strong>
                    <%= movie.duration %> minutes
                </p>

                <p>
                    <strong>Language:</strong>
                    <%= movie.language %>
                </p>

                <p>
                    <strong>Director:</strong>
                    <%= movie.director %>
                </p>

                <p>
                    <strong>Cast:</strong>
                    <%= movie.cast %>
                </p>

                <p>
                    <strong>Rating:</strong>
                    <%= movie.rating %>
                </p>


                <div class="actions">

                    <a
                        href="/movies/edit/<%= movie._id %>"
                        class="btn"
                    >
                        Edit Movie
                    </a>


                    <form
                        action="/movies/delete/<%= movie._id %>"
                        method="POST"
                    >

                        <button
                            type="submit"
                            class="btn delete-btn"
                        >
                            Delete Movie
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</body>

</html>