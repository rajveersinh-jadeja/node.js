<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit Movie</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
            padding: 40px;
        }

        .container {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        h1 {
            margin-bottom: 25px;
            text-align: center;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        input,
        textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font: inherit;
        }

        textarea {
            min-height: 100px;
            resize: vertical;
        }

        .btn {
            padding: 10px;
            border: none;
            background: #222;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }

        .back-link {
            display: block;
            margin-top: 20px;
            text-align: center;
            color: #555;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Edit Movie</h1>

        <form action="/movies/edit/<%= movie._id %>" method="POST">

            <input type="text" name="title" value="<%= movie.title %>" required>

            <textarea name="description" required><%= movie.description %></textarea>

            <input type="text" name="genre" value="<%= movie.genre %>" required>

            <input type="number" name="releaseYear" value="<%= movie.releaseYear %>" required>

            <input type="number" name="duration" value="<%= movie.duration %>" required>

            <input type="text" name="language" value="<%= movie.language %>" required>

            <input type="text" name="director" value="<%= movie.director %>" required>

            <input type="text" name="cast" value="<%= movie.cast %>" required>

            <input type="number" step="0.1" name="rating" value="<%= movie.rating %>" required>

            <input type="text" name="poster" value="<%= movie.poster %>" required>

            <button type="submit" class="btn">Update Movie</button>

        </form>

        <a href="/" class="back-link">Back to Home</a>

    </div>

</body>

</html>