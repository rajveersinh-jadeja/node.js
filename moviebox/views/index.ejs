<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MovieBox</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f6f6f6;
            color: #222;
        }

        /* Navbar */

        nav {
            height: 70px;
            background: white;
            border-bottom: 1px solid #e5e5e5;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 60px;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #111;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .nav-links a {
            color: #444;
            text-decoration: none;
            font-size: 15px;
        }

        .nav-links a:hover {
            color: #000;
        }

        /* Hero */

        .hero {
            max-width: 1100px;
            margin: 60px auto 45px;
            padding: 70px 40px;

            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 14px;

            text-align: center;
        }

        .hero h1 {
            font-size: 46px;
            margin-bottom: 18px;
            letter-spacing: -1px;
        }

        .hero p {
            max-width: 600px;
            margin: auto;
            color: #666;
            font-size: 17px;
            line-height: 1.6;
        }

        .hero-buttons {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 30px;
        }

        .btn {
            display: inline-block;
            padding: 11px 20px;

            background: #222;
            color: white;

            text-decoration: none;
            border-radius: 6px;

            font-size: 14px;
        }

        .btn:hover {
            background: #444;
        }

        .outline-btn {
            background: white;
            color: #222;
            border: 1px solid #ccc;
        }

        .outline-btn:hover {
            background: #f3f3f3;
        }

        /* Movies */

        .movies-section {
            max-width: 1100px;
            margin: 0 auto 70px;
            padding: 0 20px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 22px;
        }

        .section-header h2 {
            font-size: 26px;
        }

        .view-all {
            color: #222;
            text-decoration: none;
            font-size: 14px;
        }

        .view-all:hover {
            text-decoration: underline;
        }

        .movie-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .movie-card {
            background: white;
            border: 1px solid #e1e1e1;
            border-radius: 10px;
            overflow: hidden;

            transition: transform 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .movie-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .movie-card img {
            width: 100%;
            height: 330px;

            display: block;

            object-fit: cover;
            background: #eee;
        }

        .movie-info {
            padding: 18px;
        }

        .movie-info h3 {
            font-size: 20px;
            margin-bottom: 12px;
        }

        .movie-meta {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;

            margin-bottom: 16px;
        }

        .movie-meta span {
            padding: 5px 9px;

            background: #f1f1f1;
            border-radius: 4px;

            color: #666;
            font-size: 12px;
        }

        .details-btn {
            width: 100%;
            text-align: center;
        }

        /* Responsive */

        @media (max-width: 800px) {

            nav {
                padding: 0 25px;
            }

            .nav-links {
                gap: 15px;
            }

            .hero {
                margin: 35px 20px;
                padding: 50px 25px;
            }

            .hero h1 {
                font-size: 36px;
            }

            .movie-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 550px) {

            nav {
                height: auto;
                padding: 20px;
                flex-direction: column;
                gap: 15px;
            }

            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
            }

            .hero {
                margin: 25px 15px;
                padding: 40px 20px;
            }

            .hero h1 {
                font-size: 30px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .hero-buttons .btn {
                width: 100%;
            }

            .movie-grid {
                grid-template-columns: 1fr;
            }

            .section-header {
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->

    <nav>

        <a href="/" class="logo">
            MovieBox
        </a>

        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/list">
                Movies
            </a>

            <a href="/search">
                Search
            </a>

            <a href="/movies/add">
                Add Movie
            </a>

        </div>

    </nav>


    <!-- Hero -->

    <section class="hero">

        <h1>
            Welcome to MovieBox
        </h1>

        <p>
            Manage, explore and organize your movie collection
            in one simple place.
        </p>

        <div class="hero-buttons">

            <a href="/list" class="btn">
                Browse Movies
            </a>

            <a href="/movies/add" class="btn outline-btn">
                Add Movie
            </a>

        </div>

    </section>


    <!-- Movies -->

    <section class="movies-section">

        <div class="section-header">

            <h2>
                Latest Movies
            </h2>

            <a href="/list" class="view-all">
                View All →
            </a>

        </div>


        <div class="movie-grid">

            <% if (movies && movies.length > 0) { %>

                <% movies.forEach(movie => { %>

                    <div class="movie-card">

                        <img
                            src="<%= movie.poster %>"
                            alt="<%= movie.title %>"
                            onerror="this.onerror=null; this.src='https://via.placeholder.com/300x450?text=No+Poster';"
                        >

                        <div class="movie-info">

                            <h3>
                                <%= movie.title %>
                            </h3>

                            <div class="movie-meta">

                                <span>
                                    <%= movie.genre %>
                                </span>

                                <span>
                                    <%= movie.releaseYear %>
                                </span>

                                <span>
                                    <%= movie.rating %>
                                </span>

                            </div>

                            <a
                                href="/movies/<%= movie._id %>"
                                class="btn details-btn"
                            >
                                View Details
                            </a>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <p>
                    No movies available.
                </p>

            <% } %>

        </div>

    </section>

</body>

</html>